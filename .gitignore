# Ignore datasets (too large for GitHub)
datasets/
*/datasets/
**/datasets/

# Ignore all model checkpoints and production models
# Large models should be stored on LFS, Drive, or external storage
*.h5
*.keras
*.pkl
*.npy
*.pt
*.dataset

# Fine-tuned model metadata ships with its (ignored) .keras file
models/chexpert_*_meta.json

# Training run outputs (notebook 03: checkpoints, logs, smoke-test data)
outputs/
notebooks/outputs/

# Runtime patient data and generated reports (contain patient information)
dashboard/data/
dashboard/reports/
dashboard/dashboard/

# Python virtual environment
venv/
.env
.venv
env/

# Python cache
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db

# Ignore temporary files
*.tmp
*.log

# Ignore notebooks checkpoints
.ipynb_checkpoints/
